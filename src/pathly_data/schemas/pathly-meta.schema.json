{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pathly adapter meta",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "model": { "type": "string" },
    "tools": { "type": "array", "items": { "type": "string" } },
    "can_spawn": { "type": "array", "items": { "type": "string" } },
    "spawn_section": { "type": "string" },
    "skill": { "type": "string" },
    "invocation": { "type": "string" },
    "natural_language": { "type": "string" },
    "wrapper": { "type": "string" },
    "strip_frontmatter": { "type": "boolean" },
    "filename": { "type": "string" },
    "host": { "type": "string" },
    "destination": { "type": "string" },
    "files": { "type": "array" },
    "variables": { "type": "object" },
    "templates": { "type": "object" },
    "skills": { "type": "object" },
    "structure": { "type": "string" },
    "telemetry": { "type": "boolean" },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event": { "type": "string" },
          "script": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
