{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main/index.ts",
    "src/main/preload/index.ts",
    "src/renderer/src/main.tsx",
    "src/**/*.test.{ts,tsx}",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "scripts/*.mjs"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["**/*.d.ts"],
  "ignoreDependencies": [
    "@fontsource/inter"
  ],
  "ignoreBinaries": [
    "netstat",
    "where",
    "explorer",
    "wt",
    "wsl",
    "pycharm",
    "charm",
    "pip"
  ]
}
