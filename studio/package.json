{
  "name": "pathly-studio",
  "version": "2.10.0",
  "description": "Pathly Studio — desktop app for configuring and monitoring the Pathly pipeline",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json",
    "prepare:resources": "node scripts/prepare-resources.mjs",
    "build:win": "npm run prepare:resources && npm run build && electron-builder --win",
    "build:mac": "npm run prepare:resources && npm run build && electron-builder --mac",
    "build:linux": "npm run prepare:resources && npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@dagrejs/dagre": "^3.0.0",
    "@fontsource/geist": "^5.2.9",
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@types/dagre": "^0.7.54",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^3.6.0",
    "codemirror": "^6.0.2",
    "js-yaml": "^4.1.1",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.3",
    "node-pty": "^1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reactflow": "^11.11.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/marked": "^5.0.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "electron-vite": "^2.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.0"
  }
}
